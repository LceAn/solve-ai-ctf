{
    "base_url": "https://platform.example.com",
    "auth": {
        "header": "Authorization",
        "value_prefix": "",
        "value_env": "CTF_TOKEN",
        "comment": "Token 只从环境变量 CTF_TOKEN 读取。value/value_env 绝不写真实凭证，此文件只留占位符。"
    },
    "login": {
        "method": "POST",
        "path": "/api/auth/login",
        "content_type": "application/json",
        "json_body_template": "{\"username\": \"{username}\", \"password\": \"{password}\"}",
        "credentials_env": "CTF_CREDENTIALS_JSON",
        "token_field": "data.token"
    },
    "challenges": {
        "method": "GET",
        "path": "/api/person/ctf/listTheme?competitionId={competition_id}",
        "items_field": "data",
        "map": {
            "id": "id",
            "name": "name",
            "category": "type",
            "difficulty": "difficulty",
            "points": "score"
        }
    },
    "submit": {
        "method": "POST",
        "path": "/api/person/ctf/commitAnswer",
        "content_type": "application/x-www-form-urlencoded",
        "body_template": "competitionId={competition_id}&ctfThemeId={challenge_id}&userAnswer={flag}",
        "success": {"field": "data", "equals": true},
        "retryable_http_codes": [429, 500, 502, 503],
        "timeout_seconds": 15,
        "idempotency_header": ""
    },
    "container": {
        "open": {
            "method": "POST",
            "path": "/api/person/ctf/openTheme",
            "content_type": "application/x-www-form-urlencoded",
            "body_template": "ctfThemeId={challenge_id}",
            "fields": ["dockerIp", "dockerPort", "dockerExpire"]
        },
        "close": {
            "method": "POST",
            "path": "/api/person/ctf/removeDocker",
            "content_type": "application/x-www-form-urlencoded",
            "body_template": "ctfThemeId={challenge_id}"
        },
        "status": {
            "method": "GET",
            "path": "/api/person/ctf/getCtfThemeDockerVO?competitionId={competition_id}&ctfThemeId={challenge_id}"
        },
        "max_concurrent": 3
    }
}
